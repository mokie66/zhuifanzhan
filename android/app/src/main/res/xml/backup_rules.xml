<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 及以下的备份排除规则（配合 android:fullBackupContent 使用）

    本项目不应备份任何内容：收藏、观看历史、播放进度都属于个人使用痕迹。
    allowBackup 已在清单里设为 false，这里再显式排除全部域，作为双重保险 ——
    部分定制 ROM 对 allowBackup 的实现不一致。
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
