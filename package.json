{
  "name": "personal-media-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:taxonomy": "node scripts/verify-taxonomy.mjs",
    "verify:strategy": "node scripts/verify-strategy.mjs",
    "verify:typeparam": "node scripts/verify-typeparam.mjs",
    "verify:flow": "node --import ./scripts/register-loader.mjs scripts/verify-flow.mjs",
    "verify:storage": "node --import ./scripts/register-loader.mjs scripts/verify-storage.mjs",
    "verify:config": "node --import ./scripts/register-loader.mjs scripts/verify-config.mjs",
    "verify:rank": "node --import ./scripts/register-loader.mjs scripts/verify-rank.mjs",
    "verify:cache": "node --import ./scripts/register-loader.mjs scripts/verify-cache.mjs",
    "verify:all": "npm run verify:config && npm run verify:storage && npm run verify:cache && npm run verify:rank && npm run verify:taxonomy && npm run verify:flow",
    "diagnose:sources": "node scripts/diagnose-sources.mjs",
    "diagnose:home": "node --import ./scripts/register-loader.mjs scripts/diagnose-home-perf.mjs",
    "gen:nginx": "node scripts/gen-nginx.mjs",
    "publish:github": "powershell -ExecutionPolicy Bypass -File scripts/publish-github.ps1",
    "push:api": "node scripts/push-via-api.mjs",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "hls.js": "1.7.3",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.4",
    "vite": "^6.2.0"
  }
}
